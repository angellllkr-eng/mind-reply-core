# DATABASE
DB_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql://mindreply:${DB_PASSWORD}@postgres:5432/mindreply

# STRIPE
STRIPE_SECRET_KEY=sk_live_xxxxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# CLERK AUTH
CLERK_SECRET_KEY=sk_live_xxxxx
CLERK_PUBLISHABLE_KEY=pk_live_xxxxx
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=${CLERK_PUBLISHABLE_KEY}

# REDIS
REDIS_URL=redis://redis:6379

# RWA BRIDGE
AGENT_WALLET_ADDRESS=your_wallet_address
AGENT_SESSION_KEY=your_session_key
LEGAL_ENTITY_API_URL=https://api.your-provider.com

# GRAFANA
GRAFANA_PASSWORD=your_secure_grafana_password

# ENVIRONMENT
NODE_ENV=production
VERCEL_URL=https://mind-reply.com
A11K_URL=https://a11-k.space

# LLM APIs
OPENAI_API_KEY=sk_xxxx
ANTHROPIC_API_KEY=sk_ant_xxxx

# MONITORING
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
